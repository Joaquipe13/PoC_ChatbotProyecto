# Copiar a .env y completar. Nunca versionar .env real.

# --- Base de datos ---
# Postgres con pgvector + pg_trgm. Docker local (docker-compose.yml) o Supabase/Neon para desarrollo.
# Puerto 5433 (no 5432) porque en esta máquina de desarrollo ya hay otro proyecto usando 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/fitosanitarios

# --- LLM ---
# Proveedor activo: "gemini" (principal, multimodal) o "groq" (alternativa).
LLM_PROVIDER=gemini

# Rotación de API keys de Gemini ante error 429 (cuota agotada). Al menos GEMINI_API_KEY_1
# si LLM_PROVIDER=gemini. Hasta 5 slots (_1.._5); las que falten quedan vacías, no hace
# falta completar las 5.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# (verificar) nombre de modelo vigente en https://ai.google.dev/gemini-api/docs/models antes de usar en Fase 2+.
GEMINI_MODEL=gemini-3.5-flash-lite

GROQ_API_KEY=
# (verificar) modelo vigente en https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# Modelo de embeddings multilingüe (sentence-transformers). Justificación en plandefases.md, decisión abierta #3.
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# --- WhatsApp Cloud API (Fase 8) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Verificada en vivo el 12/09/2026 contra el número de prueba (ver DECISIONES.md).
WHATSAPP_GRAPH_VERSION=v26.0
# true: normaliza 549XXXXXXXXXX -> 54XXXXXXXXXX al enviar (modo desarrollo, número de prueba argentino)
WHATSAPP_AR_QUITAR_9=true

# --- SENASA (Fase 2) ---
# (verificar) antes del crawl completo: la SPA pública puede cambiar de endpoint sin aviso.
SENASA_BASE_URL=https://aps2.senasa.gov.ar/adt_api/api
SENASA_REQ_POR_SEG=1.0

# --- Umbrales del núcleo experto (ajustables, ver DECISIONES.md al calibrarlos con datos reales) ---
DOSIS_TOLERANCIA_PCT=10.0
RAG_UMBRAL_SIMILITUD=0.35
RADIO_BUSQUEDA_ZONAS_M=2000

# --- Pronóstico del tiempo al agendar (Open-Meteo, sin API key) ---
# Información para el operario: no controla ni restringe nada. Hasta cuántos días
# adelante se muestra el pronóstico (más allá, el de viento sirve poco).
METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
METEO_HORIZONTE_DIAS=5

# --- Presentación ---
# true: consultar_marbete y responder_consulta_normativa responden dos veces, con la pregunta
# tal cual y con la reformulada, y muestran las dos (una llamada más a Gemini por consulta).
MODO_DEMO_REFORMULACION=false

# --- Tests y desarrollo ---
# true: todo el flujo corre sin red (LLM fake, SENASA desde snapshot). Default recomendado en desarrollo.
USE_FIXTURES=true
