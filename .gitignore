# Entorno y secretos
.env
.env.test
*.local

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Datos crudos (nunca versionados; solo snapshots y fixtures sí)
data/senasa/crudo/
data/senasa/snapshot/
data/insumos/**/*.pdf
data/insumos/**/*.geojson
!tests/fixtures/**

# Fotos de recetas para pruebas manuales: solo se versionan las sintéticas de ejemplo
# (las genera scripts/generar_recetas_ejemplo_el_trebol.py); una foto real puede traer
# datos de un productor o ingeniero agrónomo.
data/recetas_ejemplo/*
!data/recetas_ejemplo/README.md
!data/recetas_ejemplo/0*.jpg

# Dump de la base para Colab (se publica en el Release datos-v1, no en git)
*.dump

# Notebooks: mantener limpios de outputs pesados no es automático,
# se revisa a mano antes de commitear (ver DECISIONES.md)

# Estado interno de la herramienta (locks de sesión, etc.)
.claude/scheduled_tasks.lock

# Editor / SO
.vscode/
.idea/
.DS_Store
Thumbs.db

# Borradores de reglas.csv que dejó insumos/borrador_reglas.py (borrado el 29/09/2026)
reglas.borrador*

# Corridas de evaluación conversacional (logs de conversaciones; ver evals/)
evals/runs/
